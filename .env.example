# No edites este archivo a mano: ejecuta  npm run setup  y se crea .env con estos valores.
ADMIN_USER=
ADMIN_PASS_HASH=

# Upstash Redis (las crea Vercel al conectar la base en Storage).
# Ponlas aquí solo para  npm run migrar  o para que  npm start  use los datos del sitio publicado.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Opcionales
# PORT=3000
# Cuando el sitio esté publicado con HTTPS:
# NODE_ENV=production
# Si el hosting pone un proxy delante (Render, Railway, Nginx...):
# TRUST_PROXY=true
